{
  "name": "@henryavila/titan-chordpro-ui",
  "version": "0.2.0",
  "description": "UI ChordPro: leitura + edição. Core TypeScript + binding Vue.",
  "type": "module",
  "license": "MIT",
  "author": "Henry Avila",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henryavila/titan-chordpro-ui.git"
  },
  "bugs": {
    "url": "https://github.com/henryavila/titan-chordpro-ui/issues"
  },
  "homepage": "https://github.com/henryavila/titan-chordpro-ui#readme",
  "keywords": [
    "chordpro",
    "vue",
    "cifra",
    "viewer",
    "editor",
    "music",
    "transpose",
    "pdf"
  ],
  "main": "./dist/core/index.js",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "bin": {
    "titan-chordpro-ui": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./pdf": {
      "types": "./dist/pdf/index.d.ts",
      "import": "./dist/pdf/index.js",
      "default": "./dist/pdf/index.js"
    },
    "./slides": {
      "types": "./dist/slides/index.d.ts",
      "import": "./dist/slides/index.js",
      "default": "./dist/slides/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "default": "./dist/vue/index.js"
    },
    "./vue/style.css": "./dist/vue/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "./dist/vue/index.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "build": "tsup && vite build --config vite.lib.config.ts && tsx scripts/pack-vue.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test:browser": "playwright test",
    "pack:check": "pnpm pack --pack-destination .tmp && tar -tzf .tmp/henryavila-titan-chordpro-ui-*.tgz | head -80",
    "publish:npm": "bash scripts/publish-npm.sh",
    "release": "tsx scripts/release.ts",
    "release:apply": "tsx scripts/release.ts --apply",
    "release:ship": "tsx scripts/release.ts --ship"
  },
  "dependencies": {
    "jspdf": "^4.2.1"
  },
  "peerDependencies": {
    "vexflow": "^4.2.3",
    "vue": "^3.5.0",
    "pdfjs-dist": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "vexflow": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vexflow": "^4.2.3",
    "vite": "^7.1.3",
    "vitest": "^5.0.0",
    "vue": "^3.5.18",
    "vue-tsc": "^3.3.11"
  }
}
