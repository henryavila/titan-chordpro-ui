{
  "name": "titan-chordpro-ui",
  "version": "0.1.0",
  "description": "UI ChordPro: leitura + edição. Core TypeScript + binding Vue.",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "titan-chordpro-ui": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./pdf": {
      "types": "./dist/pdf/index.d.ts",
      "import": "./dist/pdf/index.js"
    },
    "./vue": {
      "types": "./src/vue/index.ts",
      "import": "./dist/vue/index.js"
    },
    "./vue/style.css": "./dist/vue/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsup && vite build --config vite.lib.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "jspdf": "^2.5.1"
  },
  "peerDependencies": {
    "vexflow": "^4.2.3",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "vexflow": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vexflow": "^4.2.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.18",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "core-js"
    ]
  }
}
